// Notification.java
package com.ensa.esms.ressources.entity;

import javax.persistence.*;
import java.time.LocalDateTime;

@Entity
@Table(name = "notifications")
public class Notification {
    
    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long id;
    
    @Column(name = "utilisateur_id", nullable = false)
    private Long utilisateurId;
    
    @Column(nullable = false, length = 100)
    private String titre;
    
    @Column(nullable = false, columnDefinition = "TEXT")
    private String message;
    
    @Column(length = 30)
    private String type;
    
    @Column(name = "est_lue")
    private Boolean estLue = false;
    
    @Column(name = "date_notification")
    private LocalDateTime dateNotification = LocalDateTime.now();
    
    // Constructeurs
    public Notification() {}
    
    public Notification(Long utilisateurId, String titre, String message, String type) {
        this.utilisateurId = utilisateurId;
        this.titre = titre;
        this.message = message;
        this.type = type;
    }
    
    // Getters & Setters
    public Long getId() { return id; }
    public void setId(Long id) { this.id = id; }
    
    public Long getUtilisateurId() { return utilisateurId; }
    public void setUtilisateurId(Long utilisateurId) { this.utilisateurId = utilisateurId; }
    
    public String getTitre() { return titre; }
    public void setTitre(String titre) { this.titre = titre; }
    
    public String getMessage() { return message; }
    public void setMessage(String message) { this.message = message; }
    
    public String getType() { return type; }
    public void setType(String type) { this.type = type; }
    
    public Boolean getEstLue() { return estLue; }
    public void setEstLue(Boolean estLue) { this.estLue = estLue; }
    
    public LocalDateTime getDateNotification() { return dateNotification; }
    public void setDateNotification(LocalDateTime dateNotification) { this.dateNotification = dateNotification; }
}

// NotificationRepository.java
package com.ensa.esms.ressources.repository;

import com.ensa.esms.ressources.entity.Notification;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.stereotype.Repository;
import java.util.List;

@Repository
public interface NotificationRepository extends JpaRepository<Notification, Long> {
    List<Notification> findByUtilisateurIdOrderByDateNotificationDesc(Long utilisateurId);
    List<Notification> findByUtilisateurIdAndEstLueFalse(Long utilisateurId);
}

// NotificationService.java
package com.ensa.esms.ressources.service;

import com.ensa.esms.ressources.entity.Notification;
import com.ensa.esms.ressources.repository.NotificationRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

@Service
public class NotificationService {
    
    @Autowired
    private NotificationRepository notificationRepository;
    
    /**
     * TÂCHE 3 : Créer notification automatiquement
     */
    public void creerNotificationDemandeValidee(Long personnelId, String typeDemande) {
        Notification notif = new Notification(
            personnelId,
            "Demande approuvée",
            "Votre demande de " + typeDemande + " a été approuvée.",
            "VALIDATION"
        );
        notificationRepository.save(notif);
    }
    
    public void creerNotificationDemandeRejetee(Long personnelId, String typeDemande, String motif) {
        Notification notif = new Notification(
            personnelId,
            "Demande rejetée",
            "Votre demande de " + typeDemande + " a été rejetée. Motif: " + motif,
            "REJET"
        );
        notificationRepository.save(notif);
    }
}

// DemandeService.java (extrait - à ajouter dans votre service existant)
package com.ensa.esms.ressources.service;

import com.ensa.esms.ressources.entity.Demande;
import com.ensa.esms.ressources.repository.DemandeRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

@Service
public class DemandeService {
    
    @Autowired
    private DemandeRepository demandeRepository;
    
    @Autowired
    private NotificationService notificationService; // AJOUT TÂCHE 3
    
    /**
     * Valider une demande + créer notification automatiquement
     */
    public Demande validerDemande(Long demandeId) {
        Demande demande = demandeRepository.findById(demandeId)
            .orElseThrow(() -> new RuntimeException("Demande non trouvée"));
        
        demande.setStatut("APPROUVEE");
        demande = demandeRepository.save(demande);
        
        // TÂCHE 3 : Créer notification automatiquement
        notificationService.creerNotificationDemandeValidee(
            demande.getPersonnelId(), 
            demande.getTypeDemande()
        );
        
        return demande;
    }
    
    /**
     * Rejeter une demande + créer notification automatiquement
     */
    public Demande rejeterDemande(Long demandeId, String motif) {
        Demande demande = demandeRepository.findById(demandeId)
            .orElseThrow(() -> new RuntimeException("Demande non trouvée"));
        
        demande.setStatut("REJETEE");
        demande.setCommentaireAdmin(motif);
        demande = demandeRepository.save(demande);
        
        // TÂCHE 3 : Créer notification automatiquement
        notificationService.creerNotificationDemandeRejetee(
            demande.getPersonnelId(), 
            demande.getTypeDemande(),
            motif
        );
        
        return demande;
    }
}