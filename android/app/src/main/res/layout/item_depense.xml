<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header with ID and Category -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_depense_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Dépense #1"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#1F2937" />

            <TextView
                android:id="@+id/tv_categorie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Commande"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#3B82F6"
                android:background="#E0F2FE"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Montant -->
        <TextView
            android:id="@+id/tv_montant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Montant: 1500.00 MAD"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#059669"
            android:layout_marginBottom="8dp" />

        <!-- Fournisseur -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fournisseur: "
                android:textSize="14sp"
                android:textColor="#6B7280"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_fournisseur"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ABC Corp"
                android:textSize="14sp"
                android:textColor="#374151" />
        </LinearLayout>

        <!-- Date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date: "
                android:textSize="14sp"
                android:textColor="#6B7280"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="2024-01-15"
                android:textSize="14sp"
                android:textColor="#374151" />
        </LinearLayout>

        <!-- Facture Number -->
        <LinearLayout
            android:id="@+id/layout_facture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="N° Facture: "
                android:textSize="14sp"
                android:textColor="#6B7280"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_facture_numero"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="FAC-2024-001"
                android:textSize="14sp"
                android:textColor="#374151" />
        </LinearLayout>

        <!-- Mode Paiement -->
        <LinearLayout
            android:id="@+id/layout_mode_paiement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paiement: "
                android:textSize="14sp"
                android:textColor="#6B7280"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_mode_paiement"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Virement bancaire"
                android:textSize="14sp"
                android:textColor="#374151" />
        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/tv_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description de la dépense"
            android:textSize="13sp"
            android:textColor="#6B7280"
            android:textStyle="italic"
            android:layout_marginTop="4dp"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>