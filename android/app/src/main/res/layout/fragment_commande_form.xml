<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/et_besoin_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Besoin ID"
            android:inputType="number" />

        <EditText
            android:id="@+id/et_fournisseur"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fournisseur" />

        <EditText
            android:id="@+id/et_montant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Montant total"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/et_date_commande"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Date commande (YYYY-MM-DD)" />

        <EditText
            android:id="@+id/et_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Notes" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enregistrer"
            android:layout_marginTop="12dp" />

    </LinearLayout>

</ScrollView>