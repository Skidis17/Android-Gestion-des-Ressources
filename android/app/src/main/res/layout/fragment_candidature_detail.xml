<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="#111827" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Détails candidature"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="#111827"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nom Prénom"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#111827" />

        <TextView
            android:id="@+id/tv_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="email@example.com"
            android:textColor="#6B7280" />

        <TextView
            android:id="@+id/tv_cin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="CIN: XXXXX"
            android:textColor="#6B7280" />

        <TextView
            android:id="@+id/tv_statut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="EN_ATTENTE"
            android:textStyle="bold"
            android:textColor="#111827" />

        <TextView
            android:id="@+id/tv_scores_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Scores"
            android:textStyle="bold"
            android:textColor="#111827" />

        <LinearLayout
            android:id="@+id/container_scores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btn_add_score"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Ajouter un score"
            android:backgroundTint="#2563EB"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tv_interviews_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Entretiens"
            android:textStyle="bold"
            android:textColor="#111827" />

        <LinearLayout
            android:id="@+id/container_entretiens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btn_add_entretien"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Planifier un entretien"
            android:backgroundTint="#0EA5E9"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_add_entretien_score"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Ajouter score d’entretien"
            android:backgroundTint="#0284C7"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tv_history_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Historique"
            android:textStyle="bold"
            android:textColor="#111827" />

        <LinearLayout
            android:id="@+id/container_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tv_cv_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Voir CV"
            android:textColor="#2563EB" />

        <TextView
            android:id="@+id/tv_lm_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Voir lettre de motivation"
            android:textColor="#2563EB" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_send_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Envoyer email d’acceptation" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_accept"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Accepter"
                android:backgroundTint="#16A34A"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btn_refuse"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Refuser"
                android:backgroundTint="#DC2626"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Removed "Remettre en attente" button per request -->
    </LinearLayout>
</ScrollView>
