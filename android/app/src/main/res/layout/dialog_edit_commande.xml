<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Modifier Commande"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1F2937"
        android:layout_marginBottom="16dp" />

    <!-- Read-only info -->
    <TextView
        android:id="@+id/tv_montant_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Montant: 0.00 MAD"
        android:textSize="16sp"
        android:textColor="#10B981"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_dates_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Date: N/A"
        android:textSize="14sp"
        android:textColor="#6B7280"
        android:layout_marginBottom="16dp" />

    <!-- Editable fields -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Fournisseur *"
        android:layout_marginBottom="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_fournisseur"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Statut"
        android:layout_marginBottom="12dp">

        <Spinner
            android:id="@+id/spinner_statut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Notes"
        android:layout_marginBottom="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:maxLines="5"
            android:gravity="top" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="* Champs modifiables: fournisseur, statut, notes"
        android:textSize="12sp"
        android:textColor="#9CA3AF"
        android:textStyle="italic"
        android:layout_marginTop="8dp" />
</LinearLayout>
