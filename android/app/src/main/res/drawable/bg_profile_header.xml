<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- White background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
        </shape>
    </item>

    <!-- Wave overlay at bottom -->
    <item android:gravity="bottom">
        <vector
            android:width="360dp"
            android:height="120dp"
            android:viewportWidth="360"
            android:viewportHeight="120">
            <path
                android:fillColor="#A855F7"
                android:fillAlpha="0.90"
                android:pathData="M0,60 C60,20 120,100 180,60 C240,20 300,100 360,60 L360,120 L0,120 Z" />
            <path
                android:fillColor="#7C3AED"
                android:fillAlpha="0.90"
                android:pathData="M0,78 C70,40 120,120 190,78 C260,36 310,110 360,78 L360,120 L0,120 Z" />
        </vector>
    </item>

</layer-list>
